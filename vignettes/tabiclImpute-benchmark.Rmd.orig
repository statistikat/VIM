if (length(config$n) > 1L) {
  cat("Sample-size scaling is shown separately at each missingness rate.\n")
} else {
  cat("Sample-size scaling is omitted for this single-size demonstration.\n")
}
```

```{r size-scaling, echo=FALSE, eval=have_results && has_ggplot && length(config$n) > 1L, fig.height=10}
ggplot(subset(metrics, type == "numeric"),
       aes(n, nrmse, colour = method, group = method)) +
  stat_summary(fun = mean, geom = "line") +
  stat_summary(fun = mean, geom = "point") +
  facet_grid(dataset + mechanism ~ rate, labeller = label_both) +
  scale_x_log10(breaks = config$n) + scale_y_continuous(trans = "log1p",
    breaks = function(limits) expm1(seq(log1p(max(0, limits[1])), log1p(limits[2]), length.out = 4)),
    labels = function(x) format(signif(x, 3), trim = TRUE)) +
  labs(x = "Number of rows (log scale)", y = "VIM masked-reference NRMSE",
       colour = "Method") +
  theme_minimal() + theme(legend.position = "bottom") + guides(colour = guide_legend(ncol = 3)) + theme(axis.text.x = element_text(angle = 45, hjust = 1))
```

```{r size-accuracy, echo=FALSE, eval=have_results && has_ggplot && length(config$n) > 1L, fig.height=10}
ggplot(subset(metrics, type == "categorical"),
       aes(n, accuracy, colour = method, group = method)) +
  stat_summary(fun = mean, geom = "line") +
  stat_summary(fun = mean, geom = "point") +
  facet_grid(dataset + mechanism ~ rate, labeller = label_both) +
  scale_x_log10(breaks = config$n) + ylim(0, 1) +
  labs(x = "Number of rows (log scale)", y = "Masked-cell accuracy",
       colour = "Method") +
  theme_minimal() + theme(legend.position = "bottom") + guides(colour = guide_legend(ncol = 3)) + theme(axis.text.x = element_text(angle = 45, hjust = 1))
```

```{r size-runtime, echo=FALSE, eval=have_results && has_ggplot && length(config$n) > 1L, fig.height=10}
ggplot(subset(runs, status == "ok"),
       aes(n, elapsed, colour = method, group = method)) +
  stat_summary(fun = median, geom = "line") +
  stat_summary(fun = median, geom = "point") +
  facet_grid(dataset + mechanism ~ rate, labeller = label_both) +
  scale_x_log10(breaks = config$n) + scale_y_log10() +
  labs(x = "Number of rows (log scale)", y = "Median seconds (log scale)",
       colour = "Method") +
  theme_minimal() + theme(legend.position = "bottom") + guides(colour = guide_legend(ncol = 3)) + theme(axis.text.x = element_text(angle = 45, hjust = 1))
```

For predeclared illustrative scenarios (repetition 1, MAR, 20% at each size), the next
plots show whole-table numeric deciles and categorical proportions. The
reference is the complete sampled data. This scenario is illustrative and
was not selected because a particular method performed well.

```{r marginal-plot, echo=FALSE, eval=have_results && has_ggplot, fig.height=10}
distributions <- read.csv(file.path(result_dir, "distributions.csv"))
ggplot(subset(distributions, type == "numeric"),
       aes(position, value, colour = method, linetype = method == "Reference")) +
  geom_line() + geom_point(size = 1) + facet_wrap(~n + dataset + variable, scales = "free_y") +
  scale_y_continuous(trans = "asinh") +
  labs(x = "Quantile probability", y = "Whole-table quantile (asinh scale)",
       colour = "Method", linetype = "Complete reference") + theme_minimal() + theme(legend.position = "bottom") + guides(colour = guide_legend(ncol = 3))
```

```{r proportions-plot, echo=FALSE, eval=have_results && has_ggplot, fig.height=14}
ggplot(subset(distributions, type == "categorical"), aes(method, value, fill = category)) +
  geom_col() + facet_wrap(~n + dataset + variable) + coord_flip() +
  labs(x = NULL, y = "Whole-table category proportion", fill = "Category") + theme_minimal() + theme(legend.position = "bottom")
```

```{r statistical-properties, echo=FALSE}
# Full target/scenario/repetition diagnostics are in metrics.csv.
# Here show the hardest nominal rate, still separating mechanisms and datasets.
x <- subset(metrics, rate == max(config$rates))
keys <- interaction(x$n, x$dataset, x$mechanism, x$method, x$variable, drop = TRUE)
properties <- do.call(rbind, lapply(split(x, keys), function(z) {
  cbind(z[1, c("n", "dataset", "mechanism", "method", "variable")],
    mean_difference = fmt(z$mean_difference), sd_difference = fmt(z$sd_difference),
    marginal_distance = fmt(z$marginal_distance),
    correlation_difference = fmt(z$correlation_difference))
}))
knitr::kable(properties, row.names = FALSE,
             caption = "Whole-table differences at 40% target missingness")
```

## Limitations and provenance

The configured repetitions provide descriptive comparisons. Scores apply to the
complete-case populations and artificial target missingness; they do not assess
proper multiple-imputation coverage. Pretraining overlap with these datasets has
not been independently audited. Runtime includes model initialization, fitting,
prediction and scoring, so checkpoint caching and hardware affect comparisons.
The runner records failures and warnings, package/Python versions, sample indices,
truth, masks and completions. Observed values and table schema are checked before
scoring. Raw UCI records and weights are not bundled with this vignette.
