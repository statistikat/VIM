```

```{r size-runtime, echo=FALSE, eval=have_results && has_ggplot && length(config$n) > 1L, fig.height=10}
ggplot(subset(runs, status == "ok"),
       aes(n, elapsed, colour = method, group = method)) +
  stat_summary(fun = median, geom = "line") +
  stat_summary(fun = median, geom = "point") +
  facet_grid(dataset + mechanism ~ rate, labeller = label_both) +
  scale_x_log10(breaks = config$n) + scale_y_log10() +
  labs(x = "Number of rows (log scale)", y = "Median seconds (log scale)",
       colour = "Method") +
